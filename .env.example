# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Final public URL of this site (used inside QR codes and email links).
# Decide this BEFORE issuing real certificates - QR codes are permanent.
VITE_PUBLIC_SITE_URL=https://your-portal.vercel.app

# NEVER put the service-role key or SMTP password here. They live in Supabase secrets only.
