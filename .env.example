# Client Variables (used by frontend in browser)
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
VITE_PUBLIC_SITE_URL=https://your-portal.vercel.app

# Server / API Variables (used by /api endpoints on Vercel or local dev)
# In Vercel, add these under Project Settings → Environment Variables
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Mailer Settings (Google Workspace / Gmail App Password)
SMTP_USER=certificates@yourdomain.edu
SMTP_APP_PASSWORD=abcd efgh ijkl mnop
SMTP_FROM_NAME="University Certificate Portal"

# Cron & Site URLs
SITE_URL=https://your-portal.vercel.app
CRON_SECRET=generate_any_random_secret_string
