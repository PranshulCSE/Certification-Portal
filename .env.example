# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Final public URL of this site (used inside QR codes and email links).
# Decide this BEFORE issuing real certificates - QR codes are permanent.
VITE_PUBLIC_SITE_URL=https://your-portal.vercel.app

# NEVER put the service-role key or SMTP password here. They live in Supabase secrets only.
SMTP_USER=put-your-smtp-user-here
SMTP_APP_PASSWORD=put-your-smtp-app-password-here
SMTP_FROM_NAME=put-your-smtp-from-name-here
SITE_URL=put-your-site-url-here
CRON_SECRET=put-your-cron-secret-here

